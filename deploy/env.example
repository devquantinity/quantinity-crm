# Quantinity CRM - production environment
#
# Copy to .env next to your docker-compose.yml and fill in. Never commit the
# filled-in copy: it holds the keys that decrypt your customers' data.
#
# Take the compose file itself from Twenty's repo for the version you are
# running, rather than a copy pasted here that will go stale:
#   https://github.com/twentyhq/twenty/blob/main/packages/twenty-docker/docker-compose.yml
#
# Four services: server, worker, db (postgres), redis. The worker is NOT
# optional - without it background jobs silently never run. Redis must keep
# --maxmemory-policy noeviction, or queued jobs get evicted under pressure.

# --- identity ---------------------------------------------------------------

# The public addresses, exactly as a browser sees them. A wrong value here
# breaks OAuth and every link the app puts in an email.
#
# Workspaces are reached by SUBDOMAIN - acme.crm.quantinity.com - never by a
# path. This value is the DEFAULT DOMAIN: the sign-in and workspace-picker
# page, and the thing every workspace subdomain is prefixed onto.
#
# DNS needs a wildcard A record for *.crm.quantinity.com, and TLS a Let's
# Encrypt wildcard for the same over DNS-01. Keep those records DNS-only in
# Cloudflare (grey cloud) - the free proxied certificate does not reach a
# fourth-level subdomain. See DEPLOYMENT.md section 2b.
SERVER_URL=https://crm.quantinity.com
FRONT_BASE_URL=https://crm.quantinity.com

# Pin the version. :latest means an unplanned upgrade the next time a container
# restarts, and migrations run on boot.
TAG=v2.40.0

# --- data -------------------------------------------------------------------

PG_DATABASE_URL=postgres://twenty:CHANGEME@db:5432/default
REDIS_URL=redis://redis:6379

# Encrypts secrets at rest. Generate once with `openssl rand -base64 32`.
# Back this up somewhere that is not this server. Without it, a database dump
# is a file you cannot read.
ENCRYPTION_KEY=CHANGEME

# Also generate. Sessions and tokens.
APP_SECRET=CHANGEME

# --- files ------------------------------------------------------------------

# Local disk loses every uploaded file when a container is replaced. Use S3 or
# anything S3-compatible.
STORAGE_TYPE=S_3
STORAGE_S3_REGION=ap-southeast-1
STORAGE_S3_NAME=quantinity-uploads
STORAGE_S3_ENDPOINT=
# Credentials come from the environment or the instance role - not from here if
# you can avoid it.

# --- customers --------------------------------------------------------------

# Every customer is a workspace in this one installation.
#
# TEST THIS ON A THROWAWAY INSTALL FIRST. It has broken login on some versions.
# Turn it on, make two workspaces, log out, log back into both.
IS_MULTIWORKSPACE_ENABLED=true

# Once the billing service exists, only it should create workspaces. Until
# then, open sign-up means anyone who finds the URL gets the product free.
IS_SIGN_UP_DISABLED=false

# --- sign-in ----------------------------------------------------------------

AUTH_PASSWORD_ENABLED=true

AUTH_GOOGLE_ENABLED=true
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=

# These two strings must be pasted verbatim into Google Cloud Console ->
# Credentials -> your OAuth client -> Authorised redirect URIs. They have to
# match character for character. If Google says redirect_uri_mismatch, its
# error page shows the exact URI the server sent - copy that one.
AUTH_GOOGLE_CALLBACK_URL=https://crm.quantinity.com/auth/google/redirect
AUTH_GOOGLE_APIS_CALLBACK_URL=https://crm.quantinity.com/auth/google-apis/get-access-token

# Only if the CRM and the marketing site end up on different registrable
# domains. Requires HTTPS.
# AUTH_COOKIE_SAME_SITE=none

# --- email ------------------------------------------------------------------

# Invites and password resets. Without this, an invited user never hears from
# you and you will think the invite is broken.
EMAIL_FROM_ADDRESS=hello@quantinity.com
EMAIL_FROM_NAME=Quantinity CRM
EMAIL_DRIVER=smtp
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=

# --- Quantinity app ---------------------------------------------------------
#
# The WhatsApp credentials are NOT set here. They are application variables,
# entered per workspace in the app's own Settings tab, so one customer's
# WhatsApp number never becomes another's. See RUNBOOK.md.
