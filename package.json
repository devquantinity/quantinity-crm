    "react-dom": "^19.0.0",
    "twenty-client-sdk": "2.40.0",
    "twenty-sdk": "2.40.0",
    "twenty-ui": "1.0.0-alpha.2",
    "typescript": "^5.9.3",
    "vite-tsconfig-paths": "^4.2.1",
    "vitest": "^4.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
